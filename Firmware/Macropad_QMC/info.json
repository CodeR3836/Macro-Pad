{
    "keyboard_name": "Tasin MacroPad",
    "manufacturer": "Tasin",
    "maintainer": "Tasin",
    "bootloader": "caterina",
    "processor": "atmega32u4",
    "diode_direction": "ROW2COL",

    "matrix_pins": {
        "rows": ["D1", "D0", "D4"],
        "cols": ["C6", "D7", "E6", "B4"]
    },

    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },

    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": false,
        "nkro": true
    },

    "encoder": {
        "rotary": [{
            "pin_a": "B2",
            "pin_b": "B3"
        }]
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },
                { "matrix": [0, 3], "x": 3, "y": 0 },

                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 },
                { "matrix": [1, 2], "x": 2, "y": 1 },
                { "matrix": [1, 3], "x": 3, "y": 1 },

                { "matrix": [2, 0], "x": 0, "y": 2 },
                { "matrix": [2, 1], "x": 1, "y": 2 },
                { "matrix": [2, 2], "x": 2, "y": 2 },
                { "matrix": [2, 3], "x": 3, "y": 2 }
            ]
        }
    }
}